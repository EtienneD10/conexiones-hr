# ==========================================
# Configuración de Resend para Conexiones HR
# ==========================================

# Tu API Key de Resend (la obtienes gratis en https://resend.com/api-keys)
RESEND_API_KEY=re_tu_api_key_aqui

# Email del remitente:
# - En modo de prueba / desarrollo puedes usar: Conexiones HR <onboarding@resend.dev>
# - En producción (tras verificar tu dominio en Resend): Conexiones HR <postulaciones@conexionesuy.com>
RESEND_FROM_EMAIL=Conexiones HR <onboarding@resend.dev>

# Casilla a la que llegan las postulaciones
CONTACT_NOTIFICATION_EMAIL=consultora@conexionesuy.com

